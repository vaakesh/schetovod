# database
POSTGRES_USER=schetovod
POSTGRES_PASSWORD=change_me
POSTGRES_DB=schetovod
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# application ports
APP_PORT=8001
FRONTEND_PORT=8080
# the Caddy of the server sends the domain to this port
CADDY_PORT=11200
PROD_PORT=11300
OPENAI_PROXY_URL=

# install.sh generates JWT_SECRET and adds it here
# set to 0 for plain http: Safari drops secure cookies even on localhost
AUTH_COOKIE_SECURE=1

# CloudBeaver
CLOUDBEAVER_PORT=8978
CB_SERVER_NAME=schetovod
CB_ADMIN_NAME=admin
CB_ADMIN_PASSWORD=change_me

# set to 1 to enable photo recognition, the OpenAI token goes in .openai-token
INCLUDE_API_OPENAI=0

AQSI_API_INTEGRATION=
