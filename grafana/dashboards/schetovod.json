{
  "uid": "schetovod-overview",
  "title": "Schetovod",
  "description": "API, воркер, контейнеры и логи Счетовода. Метрики Prometheus раз в 15 секунд.",
  "tags": ["schetovod"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "schetovod-api,schetovod-worker,schetovod-scheduler",
        "includeAll": true,
        "multi": false,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API up",
      "description": "Prometheus достаёт до /metrics приложения.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "refId": "A", "expr": "up{job=\"schetovod-api\"}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Worker up",
      "description": "Prometheus достаёт до /metrics воркера.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "refId": "A", "expr": "up{job=\"schetovod-worker\"}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Requests per second",
      "description": "Без /health.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(schetovod_http_server_request_duration_seconds_count[$__rate_interval]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "5xx in range",
      "description": "Ответы 5xx за выбранный период.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(schetovod_http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[$__range])) or vector(0)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests by status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) (rate(schetovod_http_server_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Response time p95 by route",
      "description": "Самый долгий маршрут — распознавание накладной, оно идёт минутами.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(schetovod_http_server_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Container CPU",
      "description": "Данные cAdvisor, обновляются раз в 30 секунд.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "interval": "30s",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",name=~\"schetovod-.*\"}[$__rate_interval])) * 100",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Container memory",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "interval": "30s",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (container_memory_working_set_bytes{job=\"cadvisor\",name=~\"schetovod-.*\"})",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Since last receipts import",
      "description": "Сколько прошло с последней удачной загрузки чеков aQsi. Значение появляется после первой удачной загрузки с момента старта воркера.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 20 },
      "targets": [{ "refId": "A", "expr": "time() - schetovod_receipts_last_success_seconds" }],
      "fieldConfig": { "defaults": { "unit": "dtdurations" } }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Task errors in range",
      "description": "Упавшие запуски задач taskiq за выбранный период, повторы тоже считаются.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(schetovod_task_errors_total[$__range])) or vector(0)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Failed recognitions in range",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(schetovod_recognition_duration_seconds_count{outcome=\"failed\"}[$__range])) or vector(0)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "OpenAI tokens in range",
      "description": "Входные и выходные токены распознавания за выбранный период.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(schetovod_recognition_tokens_total[$__range])) or vector(0)" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Recognition time p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(schetovod_recognition_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Receipts loaded from aQsi",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(schetovod_receipts_loaded_total[$__rate_interval]))",
          "legendFormat": "new receipts"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Warnings and errors",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 32 },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_namespace=\"schetovod\"} | severity_text=~\"(?i)warn.*|error|critical\"",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "showLabels": false,
        "prettifyLogMessage": false
      }
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Logs: $service",
      "description": "Сервис выбирается в списке вверху.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 42 },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_namespace=\"schetovod\",service_name=~\"$service\"}",
          "maxLines": 300
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "showLabels": false,
        "prettifyLogMessage": false
      }
    }
  ]
}
